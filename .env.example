# Instagram API Configuration
# Get from: Meta App Dashboard > Products > Instagram > Basic Display > User Token Generator
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# Meta Webhook Security
# Get from: Meta App Dashboard > Settings > Basic > App Secret
META_APP_SECRET=your_meta_app_secret_here

# Webhook verification token for subscription setup (GET /webhook)
# Set this to any secure random string, then configure the same value in Meta webhook settings
META_WEBHOOK_VERIFY_TOKEN=your_secure_random_token_here

# Feature Flags
# Enable Meta API actions (Instagram DMs, comments). Set to 'false' for testing/development.
ENABLE_META_ACTIONS=true

# Dry-run mode for action executor. Set to 'true' to log actions without executing them.
ACTION_EXECUTOR_DRY_RUN=false

# Server Configuration
# Port for the backend server (default: 3000)
PORT=3000

# API Authentication
# A strong random secret used to authenticate the RVAULT frontend and any API
# clients.  The frontend prompts once and stores it in localStorage.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Never set this in a VITE_* variable — that would expose it in the
# browser bundle.  Set it only on the server (this .env file or host secrets).
API_SECRET=your_strong_random_api_secret_here

# CORS Configuration
# Comma-separated list of allowed frontend origins for CORS
# Development: http://localhost:5173 (Vite dev server)
# Production: https://your-frontend-domain.com
# Example: http://localhost:5173,https://app.example.com
ALLOWED_ORIGINS=http://localhost:5173

# Frontend Environment Variables
# These are used during frontend build (vite build), not at runtime
# VITE_API_URL=https://your-backend-domain.com

# Database Configuration
# PostgreSQL connection string for Render, Supabase, Neon, or local PostgreSQL.
# Example: postgresql://username:password@hostname:5432/dbname?sslmode=require
# When DATABASE_URL is unset, an in-memory database is used for local tests.
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name

# Optional SQLite path (used by backup-database.js and migrate-sqlite-to-postgres.js, defaults to ./ravault.db)
# SQLITE_DB_PATH=./ravault.db


